# ---------------------------------------------------------------------------
# BhashaFlix AI — copy to .env and edit. Every value has a safe default.
# Never put a model key in frontend JavaScript; this file is server-side only.
# ---------------------------------------------------------------------------

# --- storage & limits -------------------------------------------------------
BFLIX_STORAGE_DIR=./storage
# BFLIX_DB_PATH=./storage/bhashaflix.sqlite3
BFLIX_MAX_UPLOAD_MB=512
BFLIX_MAX_DURATION_SEC=900          # 15 min per job on free CPU hardware
BFLIX_MIN_DURATION_SEC=1
BFLIX_STORAGE_QUOTA_MB=4096
BFLIX_RETENTION_HOURS=24            # 0 disables automatic deletion
BFLIX_JOB_TIMEOUT_SEC=3600
BFLIX_WORKER_THREADS=1              # keep at 1 on a single-core free tier

# --- access control ---------------------------------------------------------
# Set a long random value to require ?token= / X-API-Token on every API call.
# BFLIX_API_TOKEN=change-me-with-openssl-rand-hex-32
BFLIX_ALLOW_ANONYMOUS_JOBS=true
BFLIX_RATE_LIMIT_PER_MIN=240
BFLIX_CORS_ORIGINS=*                # e.g. https://bhashaflix.pages.dev for Pages
BFLIX_PUBLIC_BASE_URL=
BFLIX_LOG_LEVEL=INFO

# --- binaries ---------------------------------------------------------------
# BFLIX_FFMPEG=/usr/bin/ffmpeg
# BFLIX_FFPROBE=/usr/bin/ffprobe

# --- engines (auto = first available, in order of quality) ------------------
BFLIX_ASR_ENGINE=auto               # faster-whisper | openai-whisper | vosk | imported
BFLIX_ASR_MODEL=small               # tiny | base | small | medium | large-v3
BFLIX_ASR_COMPUTE_TYPE=int8         # int8 on CPU, float16 on GPU
BFLIX_DIARIZE_ENGINE=auto           # pyannote | spectral | single
BFLIX_HF_TOKEN=                     # needed for pyannote weights
BFLIX_TRANSLATE_ENGINE=auto         # nllb | argos | libretranslate | llm | auto
BFLIX_TRANSLATE_MODEL=facebook/nllb-200-distilled-600M
BFLIX_LIBRETRANSLATE_URL=
BFLIX_LIBRETRANSLATE_KEY=
BFLIX_LLM_BASE_URL=                 # any OpenAI-compatible endpoint
BFLIX_LLM_API_KEY=
BFLIX_LLM_MODEL=gpt-4o-mini
BFLIX_TTS_ENGINE=auto               # xtts | piper | espeak-ng | auto
BFLIX_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
BFLIX_PIPER_VOICES_DIR=./storage/models/piper
BFLIX_SEPARATE_ENGINE=auto          # demucs | center-suppression | ducking | auto
BFLIX_DEMUCS_MODEL=htdemucs

# --- voice cloning ----------------------------------------------------------
# OFF by default. Turning it on means you must hold the rights to the reference
# voice; cloning a real performer without permission is not allowed.
# BFLIX_ALLOW_VOICE_CLONING=0

# --- mixing ----------------------------------------------------------------
BFLIX_MAX_TEMPO=1.45                # how far a line may be sped up to fit
BFLIX_MIN_TEMPO=0.75
BFLIX_BACKGROUND_DUCK_DB=-1.5
BFLIX_DIALOGUE_GAIN_DB=0.0

# --- license gates ---------------------------------------------------------
# Read the Coqui Public Model License first. It is non-commercial.
# COQUI_TOS_AGREED=1
