{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist-web",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{apps/web-portal/**,apps/payment-api/src/**,apps/checkout-portal/{src,public}/**,apps/merchant-admin/{src,public}/**,apps/coin-wallet-store/{src,public}/**,apps/payment-help/src/**,packages/{common,core,db,merchant-sdk}/src/**,docs/**,README.md,ARCHITECTURE.md,openapi.yaml}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
